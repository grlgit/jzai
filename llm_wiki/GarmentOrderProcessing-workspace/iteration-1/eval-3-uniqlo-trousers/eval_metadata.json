{
  "eval_id": 3,
  "eval_name": "uniqlo-trousers-multi-sheet",
  "prompt": "新来了一个优衣库的裤子订单 /Users/greale/llm_wiki/GarmentOrderProcessing-workspace/test-data/order_uniqlo_trousers.xlsx ，这个订单有三个Sheet，帮我把订单信息整理出来，查一下wiki里裤子的生产标准，特别是车缝要求和标签要求",
  "assertions": [
    {
      "id": "a3_style_no",
      "text": "正确提取款号 UQ-PT-3302",
      "type": "contains",
      "target": "erp_order.json",
      "expected": "UQ-PT-3302"
    },
    {
      "id": "a3_total_qty",
      "text": "总数量正确为6460",
      "type": "contains",
      "target": "erp_order.json",
      "expected": "6460"
    },
    {
      "id": "a3_three_colors",
      "text": "识别全部3个颜色（卡其KHK、黑色BLK、深蓝NVY）",
      "type": "contains_all",
      "target": "erp_order.json",
      "expected": ["KHK", "BLK", "NVY"]
    },
    {
      "id": "a3_eight_sizes",
      "text": "识别8个尺码（28-36）",
      "type": "contains_all",
      "target": "erp_order.json",
      "expected": ["28", "29", "30", "31", "32", "33", "34", "36"]
    },
    {
      "id": "a3_delivery_date",
      "text": "正确提取交期 2025-09-30",
      "type": "contains",
      "target": "erp_order.json",
      "expected": "2025-09-30"
    },
    {
      "id": "a3_port",
      "text": "正确提取提货港（宁波港）",
      "type": "contains_any",
      "target": "erp_order.json",
      "expected": ["宁波", "Ningbo"]
    },
    {
      "id": "a3_special_req",
      "text": "提取了第三个Sheet中的特殊要求（酶洗、腰头内衬、双线车缝等）",
      "type": "contains_any",
      "target": "summary.md",
      "expected": ["酶洗", "腰头", "双线", "备用纽扣"]
    },
    {
      "id": "a3_erp_json_valid",
      "text": "输出了有效的ERP订单JSON文件",
      "type": "file_exists",
      "target": "erp_order.json"
    }
  ]
}
