---
# ============================================================
# 企业知识库架构定义 (SCHEMA.md)
#
# 本文件定义组织架构、部门结构、成员权限、目录规划。
# 放置在 workspace 根目录，启动时自动解析并初始化。
# 修改后重启服务即可生效（幂等，仅增量更新）。
# ============================================================

organization:
  name: 锦绣华裳服饰集团
  slug: jinxiu-fashion
  # 默认语言，所有 Wiki 内容以此语言生成
  language: zh

# ── 全局角色 ──────────────────────────────────────────────────
roles:
  # 超级管理员：可访问所有目录、管理组织配置
  admin:
    - wang.ming@jinxiu.com
    - li.fang@jinxiu.com

  # 普通成员：可访问全局资源（根目录文件），部门/个人按授权
  members:
    - zhang.wei@jinxiu.com
    - liu.yan@jinxiu.com
    - chen.jie@jinxiu.com
    - zhao.li@jinxiu.com
    - sun.na@jinxiu.com
    - wu.gang@jinxiu.com
    - zhou.ping@jinxiu.com
    - huang.lei@jinxiu.com
    - xu.min@jinxiu.com
    - yang.hui@jinxiu.com
    # 外部协作者（仅限指定目录，不自动获得全局资源权限）
    - ext.auditor@partner.com

# ── 部门定义 ──────────────────────────────────────────────────
departments:

  销售部:
    slug: sales
    members:
      - zhang.wei@jinxiu.com      # 普通成员（viewer）
      - liu.yan@jinxiu.com
      - chen.jie@jinxiu.com
    editors:
      - zhang.wei@jinxiu.com      # 可编辑销售部资料
    head: zhang.wei@jinxiu.com    # 部门主管（自动获得 editor）
    # 子目录名代表客户
    subdirectory_attribute: customer
    # 子目录的显示标签（用于 UI 和 Agent 提示）
    subdirectory_label: 客户

  技术研发部:
    slug: tech
    members:
      - wu.gang@jinxiu.com
      - zhou.ping@jinxiu.com
      - huang.lei@jinxiu.com
    editors:
      - wu.gang@jinxiu.com
      - zhou.ping@jinxiu.com
    head: wu.gang@jinxiu.com
    subdirectory_attribute: product_line
    subdirectory_label: 产品线

  品质管理部:
    slug: quality
    members:
      - zhao.li@jinxiu.com
      - sun.na@jinxiu.com
    editors:
      - zhao.li@jinxiu.com
    head: zhao.li@jinxiu.com
    subdirectory_attribute: standard_type
    subdirectory_label: 标准类型

  采购部:
    slug: procurement
    members:
      - xu.min@jinxiu.com
      - yang.hui@jinxiu.com
    editors:
      - xu.min@jinxiu.com
    head: xu.min@jinxiu.com
    subdirectory_attribute: supplier
    subdirectory_label: 供应商

  人力资源部:
    slug: hr
    members:
      - li.fang@jinxiu.com        # HR 总监同时是 admin
    editors:
      - li.fang@jinxiu.com
    head: li.fang@jinxiu.com
    # 无子目录属性（扁平结构）

# ── 跨部门工作组（虚拟组，不创建物理目录）────────────────────
workgroups:

  # LC-Waikiki 项目组：销售 + 品质 + 技术 联合访问
  LC-Waikiki项目组:
    slug: lw-project
    members:
      - zhang.wei@jinxiu.com      # 销售
      - zhao.li@jinxiu.com        # 品质
      - wu.gang@jinxiu.com        # 技术
    # 该工作组可访问以下目录
    grant_access:
      - path: /raw/销售部/LC-Waikiki/
        role: viewer
      - path: /raw/品质管理部/客户审核标准/
        role: viewer
      - path: /raw/技术研发部/外套/
        role: viewer

  # 年度审计组：含外部审计师
  年度审计组:
    slug: annual-audit
    members:
      - li.fang@jinxiu.com
      - ext.auditor@partner.com
    grant_access:
      - path: /raw/品质管理部/
        role: viewer
      - path: /raw/人力资源部/
        role: viewer
        # 排除敏感子目录
        exclude:
          - /raw/人力资源部/薪酬/

# ── 目录规划 ──────────────────────────────────────────────────
#
# 以下定义 /raw/ 下的目录结构。
# 未在此声明的子目录将继承父目录权限。
# scope 可选值：global, department, personal, restricted
#
directories:

  # ── 全局目录（根目录，所有成员可读）──
  # 注意：根目录文件无需在此声明，自动为 global

  # ── 部门目录 ──
  /raw/销售部:
    scope: department
    department: 销售部
    description: 客户标准、订单资料、发货要求
    # 预创建的客户子目录（也可后续手动创建，自动继承权限）
    subdirectories:
      - LC-Waikiki
      - Zara
      - H&M
      - Uniqlo
      - Mango

  /raw/技术研发部:
    scope: department
    department: 技术研发部
    description: 工艺标准、技术规范、产品开发文档
    subdirectories:
      - 外套
      - 针织
      - 牛仔
      - 衬衫

  /raw/品质管理部:
    scope: department
    department: 品质管理部
    description: 质量标准、检验规范、客户审核资料
    subdirectories:
      - 国标
      - 客户审核标准
      - 检验流程
      - AQL标准

  /raw/采购部:
    scope: department
    department: 采购部
    description: 供应商资料、采购标准、面辅料规格
    subdirectories:
      - 面料供应商
      - 辅料供应商
      - 物流服务商

  /raw/人力资源部:
    scope: department
    department: 人力资源部
    description: 人事制度、培训资料、组织架构

  # ── 敏感子目录（进一步限制访问）──
  /raw/人力资源部/薪酬:
    scope: restricted
    description: 薪酬体系、调薪记录（仅 HR 主管 + admin）
    allowed_users:
      - li.fang@jinxiu.com

  /raw/人力资源部/绩效:
    scope: restricted
    description: 绩效考核方案、评估记录
    allowed_users:
      - li.fang@jinxiu.com
      - wang.ming@jinxiu.com

  # ── 共享目录（多部门共享）──
  /raw/跨部门共享:
    scope: global
    description: 多部门协作资料，所有成员可访问
    # 子目录可进一步限制
    subdirectory_attribute: project
    subdirectory_label: 项目

  /raw/跨部门共享/2024秋季新品:
    scope: restricted
    description: 2024秋季新品开发联合项目
    allowed_departments:
      - 销售部
      - 技术研发部
      - 品质管理部

  # ── 个人目录 ──
  # personal_directories: true 表示为每位成员自动创建 /raw/个人/<显示名>/
  # 个人目录仅本人可读写，admin 可读
  /raw/个人:
    scope: personal
    auto_create: true             # 为所有 members 自动创建子目录
    # 个人目录名使用 email 前缀
    naming: email_prefix          # 可选: email_prefix, display_name

# ── 全局资源描述（根目录文件说明）──────────────────────────────
# 以下文件放置在根目录 /，所有组织成员可读取
global_resources:
  description: |
    根目录存放企业级通用文档，所有员工可读取，仅管理员可上传/修改。
  expected_files:
    - 企业文化手册.pdf
    - 公司管理制度汇编.pdf
    - 员工行为准则.pdf
    - 品牌视觉识别规范.pdf
    - 邮件及公函写作规范.pdf
    - 信息安全管理制度.pdf

# ── Wiki 生成规则 ─────────────────────────────────────────────
wiki:
  # Wiki 目录结构镜像 /raw/ 权限
  # /raw/销售部/LC-Waikiki/ → /wiki/销售部/LC-Waikiki/
  mirror_raw_structure: true

  # 全局 wiki 页面（从根目录源文件生成）
  global_pages:
    - overview.md       # 知识库总览（自动维护）
    - log.md            # 操作日志（自动维护）
    - 企业文化.md        # 从企业文化手册生成
    - 管理制度.md        # 从管理制度汇编生成

  # 每个部门目录自动生成的 wiki 结构
  department_wiki_template:
    - overview.md       # 部门知识库概览
    - log.md            # 部门操作日志

# ── Agent 行为规则 ────────────────────────────────────────────
agent:
  # 写邮件/公函时，必须先参考以下资源获取语气和格式规范
  email_style_sources:
    - /邮件及公函写作规范.pdf
    - /企业文化手册.pdf

  # 回复客户询问时，按以下优先级检索
  customer_query_priority:
    - /raw/销售部/{customer}/           # 先查客户专属标准
    - /raw/品质管理部/客户审核标准/      # 再查审核标准
    - /                                 # 最后查全局标准

  # 自动回复模板来源
  auto_reply_sources:
    - /邮件及公函写作规范.pdf
    - /企业文化手册.pdf
---

# 锦绣华裳服饰集团 — 企业知识库

## 知识库总体规划

本知识库服务于集团所有部门的知识管理需求，覆盖从企业文化到具体业务标准的完整知识体系。

## 目录架构

```
/                           全局资源（企业文化、通用制度、品牌规范）
├── /raw/销售部/             客户标准与订单资料
│   ├── /LC-Waikiki/        LC Waikiki 客户专属标准
│   ├── /Zara/              Zara 客户专属标准
│   ├── /H&M/               H&M 客户专属标准
│   └── ...
├── /raw/技术研发部/         工艺标准与技术规范
│   ├── /外套/              外套产品线
│   ├── /针织/              针织产品线
│   └── ...
├── /raw/品质管理部/         质量标准与检验规范
│   ├── /国标/              国家标准
│   ├── /客户审核标准/       客户审核要求
│   └── ...
├── /raw/采购部/             供应商资料与采购标准
├── /raw/人力资源部/         人事制度与培训资料
├── /raw/跨部门共享/         联合项目资料
├── /raw/个人/               员工个人知识空间
└── /wiki/                  AI 生成的结构化知识页面（镜像 raw 结构）
```

## 权限体系

| 层级 | 读权限 | 写权限 |
|------|--------|--------|
| 根目录 `/` | 所有成员 | 仅 admin |
| 部门目录 `/raw/<部门>/` | 部门成员 + admin | 部门 editor + admin |
| 敏感目录（restricted） | 明确授权的用户 | 明确授权的用户 |
| 个人目录 `/raw/个人/<用户>/` | 仅本人 + admin | 仅本人 |
| Wiki `/wiki/` | 继承对应源目录权限 | 继承对应源目录权限 |

## 检索指南

### 按客户查询
> 需要查 LC-Waikiki 的包装标准？直接搜索客户目录：
> `search(path="/raw/销售部/LC-Waikiki/", query="包装标准")`

### 按产品线查询
> 需要查外套的工艺规范？
> `search(path="/raw/技术研发部/外套/", query="工艺规范")`

### 跨部门查询
> 权限范围内的全局搜索：
> `search(path="*", query="面料检验标准")` — 自动过滤无权限内容

### 写邮件
> Agent 会自动参考 `/邮件及公函写作规范.pdf` 和 `/企业文化手册.pdf`
