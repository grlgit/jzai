{
  "manifestVersion": "1.0",
  "appId": "com.example.multi-tab-app",
  "shortName": "multi-tab-app",
  "nsPrefix": "mt",
  "name": { "zh": "多页签示例", "en": "Multi Tab App" },
  "version": "1.0.0",
  "description": { "zh": "单面板内多页签演示：页签共享状态、keepAlive 保活，无后端无数据库" },
  "author": "Example",
  "permissions": [
    { "id": "mt:use", "label": { "zh": "使用多页签示例" }, "default": "user" }
  ],
  "panels": [
    {
      "id": "mtMain",
      "name": { "zh": "多页签示例" },
      "groupName": "应用",
      "permission": "mt:use",
      "entryComponent": "dist/pages/TabsPanel.js",
      "keepAlive": true
    }
  ]
}
