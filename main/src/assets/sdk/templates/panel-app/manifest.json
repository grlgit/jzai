{
  "manifestVersion": "1.0",
  "appId": "com.example.panel-app",
  "shortName": "panel-app",
  "nsPrefix": "pa",
  "name": { "zh": "面板示例", "en": "Panel App" },
  "version": "1.0.0",
  "description": { "zh": "最小面板型 APP：单面板 + agent 绑定，无后端无数据库" },
  "author": "Example",
  "permissions": [
    { "id": "pa:use", "label": { "zh": "使用面板示例" }, "default": "user" }
  ],
  "agents": [{ "file": "agents/pa_assistant.yaml" }],
  "panels": [
    {
      "id": "paMain",
      "name": { "zh": "面板示例" },
      "groupName": "应用",
      "permission": "pa:use",
      "entryComponent": "dist/pages/HelloPanel.js",
      "agentId": "pa_assistant",
      "keepAlive": true
    }
  ]
}
