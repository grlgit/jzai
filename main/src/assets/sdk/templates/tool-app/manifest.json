{
  "manifestVersion": "1.0",
  "appId": "com.example.tool-app",
  "shortName": "tool-app",
  "nsPrefix": "ta",
  "name": { "zh": "工具示例", "en": "Tool App" },
  "version": "1.0.0",
  "description": { "zh": "复用平台工具双通道示例：agent yaml 引用 + ctx.tools.call" },
  "author": "Example",
  "permissions": [
    { "id": "ta:use", "label": { "zh": "使用工具示例" }, "default": "user" }
  ],
  "usesPlatformTools": ["generate_pdf", "dashboard_widget"],
  "agents": [{ "file": "agents/ta_assistant.yaml" }],
  "backend": {
    "entry": "dist/backend/index.js",
    "module": "ToolAppModule",
    "toolProviders": [
      {
        "class": "ReportToolProvider",
        "toolIds": ["ta_text_summary"],
        "group": "示例",
        "tokenLimits": { "default": 8000 }
      }
    ],
    "controllers": [
      { "class": "ReportController", "handlers": ["ReportController.makePdf"] }
    ]
  },
  "panels": [
    {
      "id": "taMain",
      "name": { "zh": "工具示例" },
      "groupName": "应用",
      "permission": "ta:use",
      "entryComponent": "dist/pages/ReportPanel.js",
      "agentId": "ta_assistant"
    }
  ]
}
