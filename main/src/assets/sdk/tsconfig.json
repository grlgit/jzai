{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "jsx": "react-jsx",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "outDir": "dist",
    "types": []
  },
  "include": ["src/**/*.ts", "backend/**/*.ts", "pages/**/*.tsx", "lib/**/*.ts", "types/**/*.d.ts"]
}
